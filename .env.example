# Copie para .env e ajuste os valores. NÃO comite o .env real.
# cp .env.example .env

# =============================================================
# PostgreSQL (usado pelo serviço `db` do docker-compose)
# =============================================================
POSTGRES_USER=controlbio
POSTGRES_PASSWORD=controlbio
POSTGRES_DB=controlbio_ponto
POSTGRES_PORT=5432

# =============================================================
# Aplicação
# =============================================================
NODE_ENV=development
# Porta publicada no host (a app escuta sempre na 3000 dentro do container).
APP_PORT=3000

# =============================================================
# Banco de dados (usado pela aplicação / ORM)
# =============================================================
# Usamos Drizzle + driver postgres-js. NÃO inclua `?schema=public` (sintaxe do
# Prisma): o postgres-js repassa `schema` como parâmetro de conexão e o servidor
# rejeita (FATAL 42704). O search_path padrão já é "public".
# - Dentro do docker-compose, o host é "db" (nome do serviço).
# - Rodando a app localmente (npm run dev) contra o banco do compose, use "localhost".
DATABASE_URL=postgresql://controlbio:controlbio@localhost:5432/controlbio_ponto

# =============================================================
# Autenticação / Sessão
# =============================================================
# Tempo de expiração da sessão (em segundos). Padrão: 8h.
# (A sessão usa token aleatório guardado no banco — não há segredo a configurar.)
SESSION_MAX_AGE=28800

# Flag `Secure` do cookie de sessão.
# - HTTPS (com proxy TLS na frente): deixe vazio/true.
# - Produção servindo HTTP direto (ex.: VPS sem TLS): defina como `false`,
#   senão o navegador não envia o cookie e o login não funciona.
#   ⚠️ Sem HTTPS, senha e sessão trafegam em texto puro — prefira um proxy TLS.
SESSION_COOKIE_SECURE=false

# =============================================================
# Seed do admin inicial (usado por `npm run db:seed`)
# =============================================================
# Cria o primeiro usuário admin para destravar o acesso. Idempotente.
# Troque a senha após o primeiro login.
# O login é o USERNAME (não o e-mail). Se SEED_ADMIN_USERNAME não for definido,
# ele é derivado do 1º nome (ex.: "Administrador" -> "administrador").
# O e-mail é opcional e não é usado para login.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
# SEED_ADMIN_EMAIL=admin@controlbio.com.br   # opcional

# =============================================================
# Integração ClickUp (spec 011)
# =============================================================
# Sem CLICKUP_API_TOKEN/CLICKUP_TEAM_ID a integração fica INERTE: nada é
# enfileirado (server actions) e o worker (`npm run worker:clickup` / serviço
# `worker` do compose) loga uma linha e encerra sozinho, sem laço nenhum.

# Token da API do ClickUp (app própria da conta, NÃO é o token pessoal de cada
# usuário — esse é cadastrado por cada um na tela de perfil e fica cifrado no
# banco). Gerado em ClickUp > Configurações > Apps.
CLICKUP_API_TOKEN=

# ID do time (workspace) do ClickUp onde os projetos vivem.
CLICKUP_TEAM_ID=

# Chave de cifra (AES-256-GCM) do token pessoal de cada usuário — nunca o
# token em claro toca o banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Perder esta chave invalida TODOS os tokens pessoais já guardados — cada
# pessoa precisaria reconectar a conta ClickUp na tela de perfil. Trate como
# segredo de produção (não comite, não reaproveite entre ambientes).
CLICKUP_TOKEN_ENC_KEY=

# Teto de requisições por minuto ao ClickUp — o cliente HTTP se autolimita a
# este valor para nunca estourar o rate limit da API deles. Padrão: 90.
CLICKUP_RATE_LIMIT_PER_MIN=90

# --- Variáveis exclusivas do worker (serviço `worker` do compose) ---

# Intervalo (ms) de espera do worker quando a fila está vazia antes de
# consultar de novo. Padrão: 5000 (5s).
CLICKUP_WORKER_POLL_MS=5000

# Tentativas antes de um job da fila desistir e virar `failed` (exige reenvio
# manual pelo admin). Padrão: 5.
CLICKUP_MAX_ATTEMPTS=5